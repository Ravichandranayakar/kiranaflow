<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
  <!-- Dark Charcoal Rounded Container -->
  <rect width="32" height="32" rx="8" fill="#1C1B1B"/>
  
  <!-- Kirana Store Awning (Canopy Roof) -->
  <path d="M5 11.5 L7.5 6 L24.5 6 L27 11.5 Z" fill="#C6F26A"/>
  
  <!-- Scalloped Awning Edge -->
  <path d="M5 11.5 Q7.2 13.5 9.4 11.5 Q11.6 13.5 13.8 11.5 Q16 13.5 18.2 11.5 Q20.4 13.5 22.6 11.5 Q24.8 13.5 27 11.5" fill="none" stroke="#C6F26A" stroke-width="1.5" stroke-linecap="round"/>
  
  <!-- Storefront Side Walls / Pillars -->
  <line x1="7.5" y1="12" x2="7.5" y2="24.5" stroke="#C6F26A" stroke-width="1.75" stroke-linecap="round"/>
  <line x1="24.5" y1="12" x2="24.5" y2="24.5" stroke="#C6F26A" stroke-width="1.75" stroke-linecap="round"/>
  
  <!-- Shop Counter / Doorway -->
  <rect x="11" y="15" width="10" height="9.5" rx="1.5" fill="#C6F26A" fill-opacity="0.25" stroke="#C6F26A" stroke-width="1.5"/>
  
  <!-- Counter Shelf Items -->
  <circle cx="13.8" cy="18.5" r="1.2" fill="#C6F26A"/>
  <circle cx="18.2" cy="18.5" r="1.2" fill="#C6F26A"/>
  
  <!-- Store Base / Plinth -->
  <line x1="4.5" y1="25" x2="27.5" y2="25" stroke="#C6F26A" stroke-width="2" stroke-linecap="round"/>
</svg>
